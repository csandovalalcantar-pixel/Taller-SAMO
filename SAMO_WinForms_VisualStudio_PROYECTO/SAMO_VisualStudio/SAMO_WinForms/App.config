<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<appSettings>
		<!-- Configuración del servidor SQL Server -->
		<add key="Server" value=".\SQLEXPRESS" />

		<!-- Autenticación de Windows -->
		<add key="TrustedConnection" value="true" />
		<add key="User" value="" />
		<add key="Password" value="" />

		<!-- Bases de datos de SAMO -->
		<add key="TallerDb" value="Taller_Automotriz" />
		<add key="RefaccionesDb" value="Refaccionaria" />
	</appSettings>
</configuration>
